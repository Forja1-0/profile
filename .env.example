# Copiá a .env.local para desarrollo. En produccion estas mismas variables
# se pasan como BUILD ARGS en Easypanel (no como env runtime — Vite las
# embebe en build time).

# URL publica del backend forja-api (sin trailing slash).
# Dev:  http://localhost:3000
# Prod: https://api.tudominio.com
VITE_API_URL=http://localhost:3000

# Modo del perfil. Determina UI y nav.
#   amateur -> gym-goer casual (HomeAmateur, tab Recordatorios, sin Journey
#              ni Suscripcion, sin wearables).
#   elite   -> atleta competitivo (default).
VITE_FORJA_MODE=amateur

# Numero del bot de WhatsApp al que apuntan todos los deeplinks
# (waLink en lib/whatsapp.ts). Sin formato — solo digitos con codigo de pais.
# Ej: 5491112345678
VITE_WA_BOT_NUMBER=

# === DEV ONLY ===
# UUID de un usuario de la DB para apuntar el perfil sin pasar por el login
# de WhatsApp. NUNCA lo seteés en produccion: cualquier visitante usaria
# ese mismo perfil. En prod, la sesion la maneja /login (token de WhatsApp).
# VITE_USER_ID=
