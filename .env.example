# Copiá a .env.local para conectar contra el backend real (forja-api).
# Sin estas vars, el perfil corre en modo DEMO con datos mock.

# URL del backend (forja-api). Local: http://localhost:3000
VITE_API_URL=http://localhost:3000

# UUID del atleta (users.id). En producción llega por deeplink desde
# WhatsApp/onboarding; acá lo seteás a un user real de la DB.
VITE_USER_ID=
